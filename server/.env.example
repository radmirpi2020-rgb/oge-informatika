# Подключение к PostgreSQL.
# Локально без установки сервера: `pnpm db:start` поднимает портативный Postgres
# (пакет embedded-postgres) на порту 5433 и создаёт базу oge_site —
# тогда эта строка работает как есть.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/oge_site

# Секрет Payload (подпись cookie и токенов). Смените на длинную случайную строку.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Порт Next: http://localhost:3000/admin — админка Payload
PORT=3000

# Статический сайт (index.html) при разработке: origin, которому Payload разрешает CORS
SITE_ORIGIN=http://127.0.0.1:8080

# Адрес сайта, из которого собираются ссылки в письмах
# («подтвердить почту», «сбросить пароль»). Должен совпадать с тем,
# как сайт реально открыт: другой порт или ngrok-ссылка — поменяйте здесь.
SITE_URL=http://127.0.0.1:8080

# ---------- Почта (необязательно) ----------
# Пока SMTP_HOST пуст, Payload пишет письма в консоль сервера — удобно для проверки:
# зарегистрируйся на сайте, скопируй ссылку из консоли и открой её.
#
# Для настоящих писем заполните поля ниже. Пароль — «пароль приложения»,
# обычный пароль от почты не подойдёт (Яндекс, Gmail и Mail.ru это требуют).
#
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=почта@твойдомен.ru
# SMTP_PASS=пароль-приложения
# MAIL_FROM=почта@твойдомен.ru
# MAIL_FROM_NAME=Информатика и ОГЭ
